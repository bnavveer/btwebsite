{
  // Cloudflare Worker that serves the static site at bt.quano.us.
  // Deploy with scripts/deploy.sh, which builds dist/ with only the public files.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "btwebsite",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "bt.quano.us", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
